        let restored = values

        // 8. Storage
let anchor = Anchor(
    id: id,
    values: values,
    indices: indices,
    denseCache: nil,
    version: ingestCount,
    timestamp: clock.now(),
    originalSize: vector.count
)

try await storage.put(anchor)
        
        // 9. Manifold Evolution (Graph Update)
        if enableEvolution && !isBurst && phase == .active {
            try graph.addNode(id: id, vector: finalVector)
            graph.pruneOldNodes()
        }

// 10. Indexing (must be last)
approximateIndex.insert(finalVector)
    
    /// Retrieves a vector by ID.
    /// - Parameter id: The unique identifier.
    /// - Returns: The reconstructed vector, or nil if not found.
    public func retrieve(id: String) async throws -> [Float]? {
        guard let anchor = try await storage.get(id) else { return nil }

if let cached = anchor.denseCache {
    return cached
}

return try compression.decompress(
    values: anchor.values,
    indices: anchor.indices,
    originalSize: anchor.originalSize
)
    }
    
    /// Creates a checkpoint of the current state.
    public func checkpoint() async throws {
        try await storage.checkpoint()
    }
    
    /// Restores state from a checkpoint.
    public func restore() async throws {
        try await storage.restore()
    }
    
    /// Returns the current system phase.
    public var currentPhase: SystemPhase {
        return phase
    }
    
    // MARK: - Private Helpers
    
    private func updatePhase() {
        if phase == .coldStart && ingestCount >= warmupTarget {
            phase = .warming
        } else if phase == .warming && ingestCount >= warmupTarget * 2 {
            phase = .active
        }
    }
    
    private func findNearestVector(_ vector: [Float]) -> [Float]? {
