// MARK: - DUMEHybridEngine (CORE INTEGRATION LAYER)

/*
 This model represents the core integration layer (DUMEHybridEngine.swift) that orchestrates all modular components
 (Compression, Safety, Speculation, Manifold Evolution, Storage, and Encryption) into a unified deterministic system.

 It is the "brain" of the architecture, responsible for maintaining system state, coordinating subsystems, and ensuring
 reproducible behavior across ingestion and retrieval.

 ────────────────────────────────────────────────────────────────────────────────
 KEY ARCHITECTURAL FEATURES
 ────────────────────────────────────────────────────────────────────────────────

 1. State Machine
    - coldStart → warming → active
    - Progresses based on ingestion count
    - Controls activation of graph evolution and speculation

 2. Graceful Degradation
    - All advanced systems are optional:
        • Speculation Engine
        • Burst Protection
        • Manifold Evolution (Graph)
    - System remains fully functional if any subsystem is disabled

 3. Actor-Based Concurrency
    - Storage layer uses Swift actors
    - Ensures thread-safe persistence and retrieval
    - Safe concurrent ingestion/retrieval pipeline

 4. Deterministic Core
    - Same input always produces same stored envelope
    - Full reproducibility guaranteed via:
        • DeterministicEnvelope
        • Stable compression
        • Stable indexing

 ────────────────────────────────────────────────────────────────────────────────
 INGEST PIPELINE (WRITE PATH)
 ────────────────────────────────────────────────────────────────────────────────

 Step 1 — Validation
    - Reject empty IDs
    - Reject empty vectors

 Step 2 — Phase Update
    - Increment ingest counter
    - Update system phase (coldStart → warming → active)

 Step 3 — Burst Detection
    - Monitor entropy via BurstDetector
    - If burst detected:
        • Disable speculative modification
        • Force safe deterministic compression

 Step 4 — Speculation (Active Only)
    - If phase == active AND not burst:
        • Estimate nearest vector
        • Compute velocity
        • Apply SpeculativeEngine prediction
        • Blend prediction with input using confidence weighting

 Step 5 — Compression
    - SparseCompression reduces vector dimensionality
    - Uses entropy + drift adaptive thresholding

 Step 6 — Envelope Construction
    - Wraps compressed anchor + metadata into DeterministicEnvelope
    - Captures full system state snapshot

 Step 7 — Encryption (Optional)
    - Encrypt envelope payload if encryption layer exists

 Step 8 — Storage
    - Persist encrypted envelope via DUMEPersistentStorage
    - Storage is authoritative source of truth

 Step 9 — Manifold Update (Graph Evolution)
    - Only runs in active + non-burst mode
    - Updates k-NN graph structure

 Step 10 — Indexing (Final Step)
    - Inserts final vector into ApproximateIndex
    - Must be last mutation in pipeline

 ────────────────────────────────────────────────────────────────────────────────
 RETRIEVAL PIPELINE (READ PATH)
 ────────────────────────────────────────────────────────────────────────────────

 1. Fetch raw data from storage
 2. Decrypt (if encryption enabled)
 3. Decode DeterministicEnvelope
 4. Extract Anchor
 5. Return:
    - denseCache if available
    - otherwise decompress(values + indices)

 NOTE:
    Retrieval is intentionally simple.
    No speculation, no graph traversal, no reconstruction logic beyond decompression.

 ────────────────────────────────────────────────────────────────────────────────
 LIFECYCLE MANAGEMENT
 ────────────────────────────────────────────────────────────────────────────────

 • coldStart (0–100 ingestions)
    - No graph
    - No speculation
    - Pure deterministic ingestion

 • warming (100–200 ingestions)
    - Graph begins forming
    - Speculation tested but limited

 • active (200+ ingestions)
    - Full system enabled:
        • Speculation
        • Graph evolution
        • Burst-aware optimization

 ────────────────────────────────────────────────────────────────────────────────
 DEPENDENCIES
 ────────────────────────────────────────────────────────────────────────────────

 Core Protocols:
    - DUMEMetric
    - DUMEPersistentStorage
    - DUMEEncryption

 Core Modules:
    - SparseCompression
    - SpeculativeEngine
    - GraphEvolution
    - BurstDetector
    - ApproximateIndex

 Core Types:
    - CompressionContext
    - Anchor
    - DeterministicEnvelope
    - SystemPhase
    - DUMEError
*/
import Foundation

/// The main entry point for the DUME system.
/// Orchestrates validation, compression, speculation, and storage.
public final class DUMEHybridEngine {
    
    // MARK: - Subsystems
    
    private let storage: any DUMEPersistentStorage
    private let compression: SparseCompression
    private let index: ApproximateIndex
    private let burstDetector: BurstDetector
    private let speculator: SpeculativeEngine
    private let graph: GraphEvolution
    private let metric: DUMEMetric
    private let encryption: (any DUMEEncryption)?
    
    // MARK: - State
    
    private(set) var currentPhase: SystemPhase = .coldStart
    private(set) var totalIngestions: Int = 0
    private let phaseLock = NSLock()
    
    // MARK: - Config
    
    private let enableEvolution: Bool
    private let enableSpeculation: Bool
    private let enableBurstProtection: Bool
    
    // MARK: - Constants
    
    private enum Thresholds {
        static let warming = 100
        static let active = 200
    }
    
    // MARK: - Init
    
    public init(
        storage: any DUMEPersistentStorage,
        compression: SparseCompression,
        index: ApproximateIndex,
        metric: DUMEMetric,
        encryption: (any DUMEEncryption)? = nil,
        speculator: SpeculativeEngine = SpeculativeEngine(),
        enableEvolution: Bool = true,
        enableSpeculation: Bool = true,
        enableBurstProtection: Bool = true
    ) {
        self.storage = storage
        self.compression = compression
        self.index = index
        self.metric = metric
        self.encryption = encryption
        self.speculator = speculator
        self.enableEvolution = enableEvolution
        self.enableSpeculation = enableSpeculation
        self.enableBurstProtection = enableBurstProtection
        
        self.burstDetector = BurstDetector()
        self.graph = GraphEvolution(metric: metric, k: 3)
    }
}

// MARK: - Ingestion Path

extension DUMEHybridEngine {
    
    /// Entry point for the Write Path.
    public func ingest(id: String, vector: [Float], ctx: CompressionContext) async throws {
        
        // 1. Validation
        guard !id.isEmpty else {
            throw DUMEError.invalidVector("Empty ID")
        }
        guard !vector.isEmpty else {
            throw DUMEError.invalidVector("Empty vector")
        }
        
        // 2. Phase Update
        updateSystemPhase()
        
        // 3. Burst Detection
        if enableBurstProtection {
            burstDetector.update(entropy: ctx.entropy)
        }
        let isBurst = burstDetector.isBurstMode
        
        // 4. Speculation
        var finalVector = vector
        
        if enableSpeculation && currentPhase == .active && !isBurst {
            if let nearest = findNearest(vector) {
                let velocity = zip(vector, nearest).map { $0 - $1 }
                let result = speculator.speculate(current: nearest, velocity: velocity)
                
                if result.isValid {
                    let alpha = min(0.9, result.confidence)
                    finalVector = zip(vector, result.predicted).map {
                        ($0 * (1 - alpha)) + ($1 * alpha)
                    }
                }
            }
        }
        
        // 5. Compression
        let (values, indices) = try compression.compress(
            finalVector,
            entropy: ctx.entropy,
            drift: ctx.drift,
            isBurstMode: isBurst
        )
        
        let anchor = Anchor(
            id: id,
            values: values,
            indices: indices,
            denseCache: nil,
            version: totalIngestions,
            timestamp: Date().timeIntervalSince1970,
            originalSize: vector.count
        )
        
        // 6. Envelope
        let envelope = DeterministicEnvelope(
            anchor: anchor,
            entropy: ctx.entropy,
            drift: ctx.drift,
            isBurst: isBurst,
            phase: currentPhase,
            speculationApplied: enableSpeculation && !isBurst && currentPhase == .active,
            speculationConfidence: nil,
            ingestIndex: totalIngestions,
            timestamp: Date().timeIntervalSince1970,
            checksum: "\(id)-\(totalIngestions)"
        )
        
        // 7. Encode + Encrypt
        let encoded = try JSONEncoder().encode(envelope)
        let secured = try encryption?.encrypt(encoded) ?? encoded
        
        // 8. Storage (Actor call)
        try await storage.putRaw(id, data: secured)
        
        // 9. Graph Evolution
        if enableEvolution && currentPhase == .active && !isBurst {
            graph.update(id: id, vector: finalVector)
        }
        
        // 10. Indexing (MUST BE LAST)
        index.insert(finalVector)
    }
}

// MARK: - Retrieval Path

extension DUMEHybridEngine {
    
    public func retrieve(id: String) async throws -> [Float]? {
        
        // 1. Fetch
        guard let raw = try await storage.getRaw(id) else {
            return nil
        }
        
        // 2. Decrypt
        let decrypted = try encryption?.decrypt(raw) ?? raw
        
        // 3. Decode
        let envelope = try JSONDecoder().decode(
            DeterministicEnvelope.self,
            from: decrypted
        )
        
        let anchor = envelope.anchor
        
        // 4. Return cached or decompress
        if let cached = anchor.denseCache {
            return cached
        }
        
        return try compression.decompress(
            values: anchor.values,
            indices: anchor.indices,
            originalSize: anchor.originalSize
        )
    }
}

// MARK: - Helpers

private extension DUMEHybridEngine {
    
    func updateSystemPhase() {
        phaseLock.lock()
        defer { phaseLock.unlock() }
        
        totalIngestions += 1
        
        if totalIngestions >= Thresholds.active {
            currentPhase = .active
        } else if totalIngestions >= Thresholds.warming {
            currentPhase = .warming
        }
    }
    
    func findNearest(_ vector: [Float]) -> [Float]? {
        
        // Fast path: index
        if let approx = index.nearest(to: vector, metric: metric) {
            return approx
        }
        
        // Fallback: graph
        let nodes = graph.getAllNodes()
        guard !nodes.isEmpty else { return nil }
        
        var best: [Float]?
        var minDistance = Float.infinity
        
        for node in nodes {
            let d = metric.distance(vector, node.vector)
            if d < minDistance {
                minDistance = d
                best = node.vector
            }
        }
        
        return best
    }
}
