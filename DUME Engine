    /// Ingests a vector into the system.
    /// - Parameters:
    ///   - id: Unique identifier for the anchor.
    ///   - vector: The high-dimensional vector to ingest.
    ///   - ctx: Context containing entropy and drift metrics.
    /// - Throws: DUMEError if validation fails or storage fails.
    public func ingest(id: String, vector: [Float], ctx: CompressionContext) async throws {
        // 1. Input Validation
        guard !id.isEmpty else {
            throw DUMEError.invalidVector("Cannot ingest anchor with empty ID")
        }
        guard !vector.isEmpty else {
            throw DUMEError.invalidVector("Cannot ingest empty vector")
        }
        
        // 2. Phase Management (Warmup Logic)
        ingestCount += 1
        updatePhase()
        
        // 3. Burst Detection & Protection
        if enableBurstProtection {
            burstDetector.update(entropy: ctx.entropy)
        }
        let isBurst = burstDetector.isBurstMode
        
        // 4. Speculative Reconstruction (Only if active and not in burst)
        var finalVector = vector
