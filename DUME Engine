        let alpha = min(0.9, result.confidence)
        return $0 * (1 - alpha) + $1 * alpha
    }
} 
        // 5. Compression
        let (values, indices) = try compression.compress(
            finalVector,
            entropy: ctx.entropy,
            drift: ctx.drift,
            isBurstMode: isBurst
        )
        
        // 6. Encryption (Optional)
        let raw = Data(bytes: values, count: values.count * MemoryLayout<Float>.size)
        let securedData = try crypto?.encrypt(raw) ?? rawData

